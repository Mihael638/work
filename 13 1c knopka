&НаКлиенте
Процедура СоздатьВыдачу(Команда)
    // 1. Проверка на то, что выбраны заявки
    Если Команда.Параметр.Количество() = 0 Тогда
        Предупреждение("Выберите хотя бы одну заявку!");
        Возврат;
    КонецЕсли;
    
    // 2. Проверка изюминки (одного читателя)
    ПерваяЗаявка = Команда.Параметр[0];
    ЧитательЗаявки = ПерваяЗаявка.Читатель;
    
    Для Каждого ТекЗаявка Из Команда.Параметр Цикл
        Если ТекЗаявка.Читатель <> ЧитательЗаявки Тогда
            Предупреждение("Все выделенные заявки должны быть от одного читателя!");
            Возврат; // Выход из процедуры
        КонецЕсли;
    КонецЦикла;
    
    // 3. Открытие формы сводного документа
    // Формируем массив оснований
    МассивОснований = Команда.Параметр;
    
    // Открываем форму документа ВыдачаКниг с параметром
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Основание", МассивОснований);
    
    ОткрытьФорму("Документ.ВыдачаКниг.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры
