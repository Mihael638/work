&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    // Если форма открыта с параметром "Основание"
    Если Параметры.Свойство("Основание") Тогда
        МассивОснований = Параметры.Основание;
        
        // 1. Заполняем шапку (Читатель берем из первой заявки)
        ПерваяЗаявка = МассивОснований[0];
        Объект.Читатель = ПерваяЗаявка.Читатель;
        
        // 2. Очищаем ТЧ на всякий случай
        Объект.ВыданныеКниги.Очистить();
        
        // 3. Переносим строки из всех заявок
        Для Каждого ТекЗаявка Из МассивОснований Цикл
            // Получаем полный объект заявки, чтобы прочитать ТЧ
            ОбъектЗаявки = ТекЗаявка.ПолучитьОбъект();
            
            Для Каждого СтрокаЗаявки Из ОбъектЗаявки.СписокКниг Цикл
                НоваяСтрока = Объект.ВыданныеКниги.Добавить();
                НоваяСтрока.Книга = СтрокаЗаявки.Книга;
                НоваяСтрока.Количество = СтрокаЗаявки.Количество;
            КонецЦикла;
        КонецЦикла;
        
    КонецЕсли;
    
КонецПроцедуры
